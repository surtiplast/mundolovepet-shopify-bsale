# Mundo Love Pet — Shopify × Bsale
#
# Copia este archivo a `.env` y rellena los valores. El `.env` NUNCA se sube al
# repositorio: está en el .gitignore.
#
#     cp .env.example .env
#     npm run keygen        # genera ENCRYPTION_KEY
#
# La app valida esta configuración al arrancar (src/config/env.ts) y se niega a
# iniciar si algo obligatorio falta o tiene mal formato. Es a propósito: mejor
# un fallo ruidoso al desplegar que descubrir a mitad de una facturación que la
# clave de cifrado estaba vacía.

# ─────────────────────────────────────────────── Básico
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# ─────────────────────────────────────────────── Base de datos
# En Render la inyecta el blueprint. En local, tu PostgreSQL.
# Si no hay base disponible, la app arranca con un almacén en memoria y lo
# avisa en el log: sirve para probar conexiones, pero los tokens no persisten.
DATABASE_URL=postgresql://usuario:clave@localhost:5432/mlp_sync

# Cola de trabajos. Opcional hasta la Fase 3.
REDIS_URL=

# ─────────────────────────────────────────────── Seguridad
# ENCRYPTION_KEY: 32 bytes en base64. Genérala con `npm run keygen`.
#
# ⚠️ Si la pierdes, los tokens guardados en la base quedan irrecuperables y hay
#    que volver a introducirlos. Guárdala fuera del servidor.
ENCRYPTION_KEY=

# Mínimo 32 caracteres. Cualquier cadena larga y aleatoria sirve.
SESSION_SECRET=

# ─────────────────────────────────────────────── Panel
ADMIN_EMAIL=surtiplast.pe@gmail.com
# Hash argon2id de la contraseña del panel. Opcional hasta que se active la
# autenticación (fase posterior).
ADMIN_PASSWORD_HASH=

# ─────────────────────────────────────────────── Shopify
# Formato exacto: tu-tienda.myshopify.com — sin https:// ni barra final.
SHOPIFY_SHOP_DOMAIN=mundolovepet.myshopify.com

# Admin API access token de la Custom App. Empieza por shpat_
# Se muestra UNA SOLA VEZ al instalar la app: guárdalo antes de cerrar.
# Scopes necesarios: read_products, write_products, read_inventory,
# write_inventory, read_orders, read_customers, read_locations
SHOPIFY_ADMIN_TOKEN=

SHOPIFY_API_VERSION=2026-07

# Para verificar la firma HMAC de los webhooks. Necesario desde la Fase 4.
SHOPIFY_WEBHOOK_SECRET=

# ─────────────────────────────────────────────── Bsale
# Token de la cuenta Bsale Perú.
#
# Para pruebas: cuenta sandbox gratuita en https://account.bsale.dev/users/create
# Para producción: crea un usuario dedicado («Integración Shopify») en vez de
# usar tu token personal. Así los documentos quedan atribuidos a ese usuario y
# puedes revocarlo sin afectar a nadie más.
BSALE_ACCESS_TOKEN=

BSALE_API_BASE_URL=https://api.bsale.io/v1

# ─────────────────────────────────────────────── IDs de Bsale
# DÉJALOS VACÍOS. Los descubre la propia app:
#
#     GET /api/connections/bsale/discover
#
# ⚠️ Los IDs de «Boleta Electrónica» y «Factura Electrónica» varían entre
#    cuentas de Bsale. Copiarlos de otro sitio, o aceptar la sugerencia de la
#    app sin mirarla, es la forma más rápida de emitir el tipo de comprobante
#    equivocado ante SUNAT. Confírmalos visualmente antes de pegarlos aquí.
BSALE_OFFICE_ID=
BSALE_PRICE_LIST_ID=
BSALE_DOCTYPE_BOLETA_ID=
BSALE_DOCTYPE_FACTURA_ID=
BSALE_TAX_ID_IGV=

# Segmento secreto de la URL de webhooks de Bsale. Necesario desde la Fase 3.
# Genéralo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BSALE_WEBHOOK_PATH_SECRET=
